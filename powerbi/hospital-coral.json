{
  "name": "Hospital - Coral claro",
  "dataColors": [
    "#D66D53", "#B57585", "#667A8A", "#78978B",
    "#F2A07B", "#8A7BA2", "#C29861", "#B0B8BE"
  ],
  "background": "#FFFFFF",
  "foreground": "#2F2F2F",
  "foregroundNeutralSecondary": "#6B6B6B",
  "backgroundLight": "#EEE8E4",
  "backgroundNeutral": "#FAF7F5",
  "tableAccent": "#D66D53",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "color": "#2F2F2F" },
    "title": { "fontFace": "Segoe UI Semibold", "color": "#2F2F2F" },
    "header": { "fontFace": "Segoe UI Semibold", "color": "#2F2F2F" },
    "label": { "fontFace": "Segoe UI", "color": "#6B6B6B" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          { "color": { "solid": { "color": "#FAF7F5" } }, "transparency": 0 }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }
        ],
        "border": [
          { "show": true, "color": { "solid": { "color": "#E8E1DD" } }, "width": 1, "radius": 8 }
        ],
        "dropShadow": [ { "show": false } ]
      }
    }
  }
}
